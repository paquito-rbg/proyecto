
<label>¿Tienes hijos? echo por luis felipe ambrosio velazquez
</label>
<select id="hijos" onchange="mostrarHijos()">
  <option value="">Selecciona</option>
  <option value="si">Sí</option>
  <option value="no">No</option>
</select>

<div id="datosHijos" style="display:none;">
  <p>¿Cuántos hijos tienes?</p>
  <input type="number" min="1" placeholder="Cantidad">

  <p>¿Qué edades tienen?</p>
  <input type="text" placeholder="Ejemplo: 5 y 8 años">
</div>

<script>
function mostrarHijos() {
  let respuesta = document.getElementById("hijos").value;

  document.getElementById("datosHijos").style.display =
    respuesta === "si" ? "block" : "none";
}
</script>

